---
// Página de un producto: presentación, sus trabajos, su simulador y sus precios
import { Image } from 'astro:assets';
import Sitio from '../layouts/Sitio.astro';
import Galeria from './Galeria.astro';
import Configurador from './Configurador.astro';
import Precios from './Precios.astro';
import { telas, marcos, cuadrito, desde, trabajos, type Producto } from '../data/estudio';
import fotoTapices from '../assets/portada-tapices.jpg';
import type { ImageMetadata } from 'astro';
import { ui, rutaDe, euros, type Lang } from '../i18n/ui';

interface Props { lang: Lang; producto: Producto }
const { lang, producto } = Astro.props;
const t = ui[lang];
const pagina = producto === 'tapiz' ? 'linum' : 'cuadritos';
const p = producto === 'tapiz' ? t.paginas.linum : t.paginas.cuadritos;
// Cabecera: tres columnas que se deslizan con fotos de trabajos de este producto y muestras de él,
// telas enmarcadas en los tapices y cuadritos montados (tela de fondo y diseño) en los cuadritos.
type Pieza =
  | { tipo: 'foto'; imagen: ImageMetadata }
  | { tipo: 'tela'; imagen: ImageMetadata; madera: string }
  | { tipo: 'cuadrito'; tela: ImageMetadata; diseno: ImageMetadata };
const fotos: Pieza[] = [
  ...(producto === 'tapiz' ? [{ tipo: 'foto' as const, imagen: fotoTapices }] : []),
  ...trabajos[producto].map((x) => ({ tipo: 'foto' as const, imagen: x.imagen })),
];
const maderas = marcos.filter((m) => m.color).map((m) => m.color!);
const muestras: Pieza[] =
  producto === 'tapiz'
    ? ['tanger', 'osaka', 'habana', 'granada', 'katmandu', 'cadiz', 'bogota'].map((slug, i) => ({
        tipo: 'tela' as const, imagen: telas.find((x) => x.slug === slug)!.imagen, madera: maderas[i % maderas.length],
      }))
    : ([['flores-verdes', 'madre'], ['rayas-teja', 'sagrado-corazon'], ['hojas-malva', 'desamparados'], ['ramitas-mostaza', 'pilar'], ['granadas', 'sagrado-corazon'], ['rayas-azules', 'desamparados']] as const).map(([tl, d]) => ({
        tipo: 'cuadrito' as const,
        tela: cuadrito.telas.find((x) => x.slug === tl)!.imagen,
        diseno: cuadrito.disenos.find((x) => x.slug === d)!.imagen,
      }));
// Se intercalan: una muestra cada dos fotos (o cada foto, si hay pocas)
const cada = fotos.length > muestras.length * 1.5 ? 2 : 1;
const piezas: Pieza[] = [];
let m = 0;
fotos.forEach((f, i) => { piezas.push(f); if ((i + 1) % cada === 0 && m < muestras.length) piezas.push(muestras[m++]); });
while (m < muestras.length) piezas.push(muestras[m++]);
const COLUMNAS = 3;
const columnas = Array.from({ length: COLUMNAS }, (_, c) => piezas.filter((_, i) => i % COLUMNAS === c));
const ritmos = [70, 86, 78];
const otro: Producto = producto === 'tapiz' ? 'cuadrito' : 'tapiz';

const datos =
  producto === 'tapiz'
    ? [[telas.length, t.paginas.linum.telas], [marcos.filter((m) => m.color).length, t.paginas.linum.maderas]]
    : [[cuadrito.telas.length, t.paginas.cuadritos.telas], [cuadrito.disenos.length, t.paginas.cuadritos.disenos]];
---
<Sitio lang={lang} pagina={pagina} title={p.title} description={p.description}>
  <section class="intro" aria-labelledby="intro-title">
    <div class="wrap intro-grid">
    <div class="intro-inner">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 id="intro-title">{p.titulo} <em>{p.tituloEm}</em></h1>
      <p class="lede">{p.lede}</p>
      <div class="intro-actions">
        <a class="btn btn-primary" href="#configurador">{p.disenar}</a>
        <a class="btn btn-secondary" href="#precios">{t.precios.eyebrow}</a>
      </div>
      <ul class="facts" aria-label={t.a11y.resumen}>
        {datos.map(([n, texto]) => <li><strong>{n}</strong> {texto}</li>)}
        <li>{t.hero.desde} <strong>{euros(lang, desde[producto])}</strong></li>
      </ul>
    </div>
    <div class="vitrina" data-vitrina>
      <div class="vitrina-cols" aria-hidden="true">
      {columnas.map((col, c) => (
        <div class="vitrina-col" style={`--dur:${ritmos[c]}s;--delay:-${(ritmos[c] * c) / 3}s`}>
          {[...col, ...col, ...col].map((x, i) => {
            const eager = i < 2 ? 'eager' : 'lazy';
            if (x.tipo === 'foto') return <Image class="vitrina-foto" src={x.imagen} alt="" widths={[240, 400]} sizes="(min-width: 960px) 13vw, 32vw" loading={eager} />;
            if (x.tipo === 'tela') return (
              <span class={`vitrina-muestra campo-${i % 3}`}>
                <span class="vitrina-marco" style={`--madera:${x.madera}`}><Image src={x.imagen} alt="" width={200} height={200} quality={72} loading={eager} /></span>
              </span>
            );
            return (
              <span class={`vitrina-muestra campo-${i % 3}`}>
                <span class="vitrina-marco vitrina-cuadrito">
                  <Image class="cuadrito-tela" src={x.tela} alt="" width={200} quality={72} loading={eager} />
                  <span class="cuadrito-lamina"><Image src={x.diseno} alt="" width={160} quality={75} loading={eager} /></span>
                </span>
              </span>
            );
          })}
        </div>
      ))}
      </div>
      <button class="vitrina-pausa" type="button" aria-pressed="false" aria-label={t.a11y.pausar} data-pausa>
        <svg class="icono-pausa" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
        <svg class="icono-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5.5v13l10.5-6.5z"/></svg>
      </button>
    </div>
    </div>
  </section>

  <Galeria lang={lang} producto={producto} />
  <Configurador lang={lang} producto={producto} />
  <Precios lang={lang} producto={producto} />

  <aside class="otro" aria-label={t.productos[otro].nombre}>
    <div class="wrap otro-inner">
      <p>{t.otro[producto].texto(euros(lang, desde[otro]))}</p>
      <a class="btn btn-secondary" href={rutaDe(lang, otro === 'tapiz' ? 'linum' : 'cuadritos')}>{t.otro[producto].ver} <span aria-hidden="true">→</span></a>
    </div>
  </aside>
</Sitio>

<script>
  // Pausa del movimiento de la cabecera
  document.querySelectorAll<HTMLElement>('[data-vitrina]').forEach((v) => {
    const b = v.querySelector<HTMLButtonElement>('[data-pausa]')!;
    b.addEventListener('click', () => {
      const pausado = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(pausado));
      v.toggleAttribute('data-pausado', pausado);
    });
  });
</script>

<style>
  /* —— Cabecera: texto a la izquierda y una vitrina de columnas en movimiento a la derecha —— */
  .intro { padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(1rem, 0.5rem + 2vw, 2rem); overflow-x: clip; }
  .intro-grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: center; }
  @media (min-width: 960px) {
    .intro-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  }
  .vitrina {
    --campo-0: #e7ebe0; --campo-1: #e5dacb; --campo-2: #d3dccb;
    position: relative; overflow: hidden; height: 26rem;
    background: var(--sunken); border-radius: calc(var(--radius) * 1.5);
  }
  @media (min-width: 960px) {
    /* La vitrina llega hasta el borde derecho de la ventana */
    .vitrina { margin-right: calc((100vw - min(100vw - 2 * var(--gutter), var(--max))) / -2); border-radius: calc(var(--radius) * 1.5) 0 0 calc(var(--radius) * 1.5); height: min(calc(100svh - var(--topbar-h, 64px) - 4rem), 40rem); }
  }
  .vitrina-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; padding: 0 0.75rem; height: 100%; }
  .vitrina-col { animation: vitrina var(--dur) linear var(--delay) infinite; }
  .vitrina-col:nth-child(even) { animation-direction: reverse; }
  @keyframes vitrina { to { translate: 0 calc(-100% / 3); } }
  .vitrina[data-pausado] .vitrina-col { animation-play-state: paused; }
  /* Margen en vez de gap: así un tercio exacto de la columna es una vuelta completa */
  .vitrina-col > * { display: block; width: 100%; margin-bottom: 0.75rem; border-radius: 10px; }
  .vitrina-foto { height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
  .vitrina-muestra { display: grid !important; place-items: center; aspect-ratio: 3 / 4; }
  .campo-0 { background: var(--campo-0); } .campo-1 { background: var(--campo-1); } .campo-2 { background: var(--campo-2); }
  .vitrina-marco { display: block; width: 58%; aspect-ratio: 3 / 4; padding: 7%; background: var(--madera, #c39a6b); box-shadow: 0 10px 18px -12px rgb(42 36 31 / 0.5); }
  .vitrina-marco img { width: 100%; height: 100%; object-fit: cover; }
  .vitrina-cuadrito { position: relative; width: 52%; aspect-ratio: 20 / 27; }
  .vitrina-cuadrito .cuadrito-tela { position: absolute; inset: 7%; width: 86%; height: 86%; }
  .cuadrito-lamina { position: absolute; inset: 24% 26%; display: grid; place-items: center; background: #f6efe2; padding: 6%; }
  .cuadrito-lamina img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .vitrina-pausa {
    position: absolute; right: 1rem; bottom: 1rem;
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--rule); background: var(--raised); color: var(--ink); cursor: pointer;
  }
  .vitrina-pausa svg { width: 18px; height: 18px; }
  .vitrina-pausa .icono-play, .vitrina-pausa[aria-pressed='true'] .icono-pausa { display: none; }
  .vitrina-pausa[aria-pressed='true'] .icono-play { display: block; }
  @media (prefers-reduced-motion: reduce) {
    .vitrina-col { animation: none; }
    .vitrina-pausa { display: none; }
  }
  .intro-inner { display: grid; gap: 1.5rem; justify-items: start; }
  .intro h1 { font-size: var(--step-3); max-width: 16ch; }
  .intro h1 em { font-style: italic; color: var(--accent); }
  .intro .lede { max-width: 40rem; }
  .intro-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .facts { list-style: none; padding: 1.5rem 0 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; border-top: 1px solid var(--rule); color: var(--ink-2); font-size: var(--step--1); }
  .facts strong { color: var(--ink); font: 500 var(--step-1) / 1 var(--font-display); }

  .otro { background: var(--accent-soft); padding-block: clamp(2.5rem, 2rem + 2vw, 4rem); }
  .otro-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 2rem; }
  .otro p { font: 500 var(--step-1) / 1.35 var(--font-display); font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem); max-width: 40rem; }
</style>
