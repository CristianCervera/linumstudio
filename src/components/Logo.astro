---
// Marca de Linum Estudio redibujada en vector a partir del logo del catálogo.
interface Props { size?: number; class?: string }
const { size = 40, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" focusable="false">
  <path d="M34 9H91V91H44" fill="none" stroke="var(--logo-sage)" stroke-width="6" />
  <path d="M24 17V81H66" fill="none" stroke="var(--logo-pale)" stroke-width="7" />
  <path d="M11 9V92H56" fill="none" stroke="var(--logo-forest)" stroke-width="9" />
  <path d="M74 33H48V68H74M48 50.5H70" fill="none" stroke="var(--logo-forest)" stroke-width="7.5" stroke-linejoin="round" stroke-linecap="round" />
</svg>
