  .frame img { width: 100%; height: 100%; object-fit: cover; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12) inset; }
  .frames[data-diptico='false'] .frame[data-frame='1'] { display: none; }
  .frames[data-diptico='true'] .frame { height: calc(var(--h) / var(--max) * 64cqh); }

  /* —— Estancias: la foto marca la escala; --fcm es el % del recorte que mide 1 cm —— */
  .wall:not([data-room='cerca']) .scene { padding: 0; }
