      0 4px 8px -4px rgb(40 30 20 / 0.3);
    transition: height 0.45s var(--ease), aspect-ratio 0.45s var(--ease), background-color 0.3s var(--ease), padding 0.3s var(--ease);
  }
  .frames[data-marco='sin'] .frame { padding: 0; }
