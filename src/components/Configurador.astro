    bottom: calc(var(--fb) * 1cqh);
    translate: -50% 0;
    gap: calc(var(--separacion) * var(--cm)); align-items: flex-end;
    transition: left 0.3s var(--ease), bottom 0.3s var(--ease);
  }
  .wall:not([data-room='cerca']) .frames[data-marco='sin'] { --m: 0; }
  .wall:not([data-room='cerca']) .frame {
    width: calc((var(--w) + 2 * var(--m)) * var(--cm));
    height: calc((var(--h) + 2 * var(--m)) * var(--cm));
    aspect-ratio: auto;
    padding: calc(var(--m) * var(--cm));
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.2) inset, 0 3px 8px -2px rgb(30 20 10 / 0.35);
    transition: width 0.3s var(--ease), height 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  /* —— Tu pared: la foto del cliente, colocada por el script en px de la pared —— */
  .wall[data-room='foto'] .scene { top: 0; height: 100%; aspect-ratio: auto; }
