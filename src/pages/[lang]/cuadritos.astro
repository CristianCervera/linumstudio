---
import PaginaProducto from '../../components/PaginaProducto.astro';
import { langs, defaultLang, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---
<PaginaProducto lang={lang} producto="cuadrito" />
