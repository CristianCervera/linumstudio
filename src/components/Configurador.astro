---
import { Image, getImage } from 'astro:assets';
import { telas, familias, tamanos, marcos, enmarcado, diptico, contacto } from '../data/estudio';
import { estancias, colocar, medidasColgado, MOLDURA, SEPARACION_DIPTICO } from '../data/estancias';
import Estancias from './Estancias.astro';
import { ui, idiomas, euros as eur, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang].config;
const f = t.foto;
const pct = diptico.descuento * 100;

const grandes = await Promise.all(
  telas.map((t) => getImage({ src: t.imagen, width: 900, format: 'webp', quality: 80 }))
);

const inicial = { tela: telas.find((t) => t.slug === 'tanger') ?? telas[0], tamano: tamanos[2], marco: marcos[1] };
const precioInicial = inicial.tamano.precio + enmarcado.precio;
const euros = (n: number) => eur(lang, n);
const marcoNombre = (id: (typeof marcos)[number]['id']) => t.marcos[id];

// Plantillas del mensaje de WhatsApp para el script: {tela}, {medida} y el marco ({marco} en minúsculas, {MARCO} tal cual)
const textos = {
  intl: idiomas[lang].intl,
  marca: `Linum Estudio · ${contacto.instagramUser} · ${contacto.telefono}`,
  tapiz: t.tapiz,
  diptico: t.diptico,
  segundo: t.segundo(pct),
  mensajes: Object.fromEntries(
    [true, false].flatMap((d) => [true, false].map((m) => [
      `${d}-${m}`,
      t.mensaje({ diptico: d, tela: '{tela}', medida: '{medida}', marco: m ? '{MARCO}' : null }),
    ]))
  ),
};
const maxAlto = Math.max(...tamanos.map((t) => t.alto));
const estanciaInicial = estancias[1];
const colgadoInicial = medidasColgado(inicial.tamano.ancho, inicial.tamano.alto, inicial.marco.id !== 'sin', false);
const sitioInicial = colocar(estanciaInicial.foto!, colgadoInicial.ancho, colgadoInicial.alto);
---
<section id="configurador" class="section config" aria-labelledby="config-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="config-title">{t.titulo}</h2>
      <p class="lede">{t.lede}</p>
    </header>

    <div class="config-grid">
      <figure class="preview">
        <div
          class="wall"
          data-wall
          data-room={estanciaInicial.id}
          style={`--fx:${sitioInicial.x};--fb:${sitioInicial.abajo};--fcm:${sitioInicial.cm};--y0:${sitioInicial.y0};--cy:${sitioInicial.cy};--moldura:${MOLDURA};--separacion:${SEPARACION_DIPTICO}`}
        >
          <div class="scene">
          <Estancias inicial={estanciaInicial.id} />
          <img class="mi-foto" data-estancia="foto" data-mi-foto alt="" />
          <div
            class="frames"
            data-frames
            data-diptico="false"
            style={`--w:${inicial.tamano.ancho};--h:${inicial.tamano.alto};--max:${maxAlto};--frame:${inicial.marco.color}`}
            data-marco={inicial.marco.id}
          >
            {[0, 1].map((i) => (
              <div class="frame" data-frame={i}>
                <img
                  src={grandes[telas.indexOf(inicial.tela)].src}
                  alt=""
                  width="900"
                  height="900"
                  decoding="async"
                  data-fabric
                />
              </div>
            ))}
          </div>
          <div class="floor" aria-hidden="true"></div>
          </div>
          <div class="calibrar" data-calibrar>
            <div class="folio" data-folio><span class="folio-esquina" data-esquina></span></div>
            <div class="foto-barra">
              <p>{f.calibrar}</p>
              <button type="button" class="foto-btn" data-sin-folio>{f.sinFolio}</button>
              <button type="button" class="foto-btn foto-btn-ok" data-listo>{f.listo}</button>
            </div>
          </div>
          <div class="foto-barra foto-acciones">
            <p data-foto-ayuda data-aprox={f.aprox}>{f.mover}</p>
            <button type="button" class="foto-btn" data-reajustar>{f.reajustar}</button>
            <button type="button" class="foto-btn" data-cambiar>{f.cambiar}</button>
          </div>
        </div>
        <figcaption class="preview-caption" aria-live="polite">
          <span class="preview-name" data-out-nombre>{inicial.tela.nombre}</span>
          <span data-out-detalle>{inicial.tamano.medida} cm · {marcoNombre(inicial.marco.id)}</span>
          <span class="preview-price" data-out-precio>{euros(precioInicial)}</span>
        </figcaption>
        <fieldset class="rooms" data-rooms>
          <legend>{t.verEn} <span class="rooms-note">· {t.escala}</span></legend>
          <div class="room-chips">
            {estancias.map((e) => (
              <label class="room-chip">
                <input
                  type="radio"
                  name="fondo"
                  value={e.id}
                  checked={e === estanciaInicial}
                />
                <span>{t.estancias[e.id]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <dialog class="guia" data-guia aria-labelledby="guia-titulo">
          <form method="dialog" class="guia-cerrar">
            <button aria-label={f.cerrar}>×</button>
          </form>
          <h3 id="guia-titulo">{f.titulo}</h3>
          <svg class="guia-dibujo" viewBox="0 0 320 150" aria-hidden="true">
            <rect width="320" height="150" rx="10" class="g-pared" />
            <rect y="128" width="320" height="22" class="g-suelo" />
            <rect x="133" y="38" width="54" height="38" rx="1" class="g-folio" />
            <text x="160" y="62" class="g-texto">A4</text>
            <path d="M88 128v-30a10 10 0 0 1 10-10h124a10 10 0 0 1 10 10v30" class="g-sofa" />
            <rect x="78" y="100" width="164" height="28" rx="8" class="g-sofa" />
          </svg>
          <p>{f.intro}</p>
          <ol>{f.pasos.map((p) => <li>{p}</li>)}</ol>
          <p class="hint">{f.privacidad}</p>
          <label class="btn btn-primary btn-block">
            <input type="file" accept="image/*" data-archivo />
            {f.subir}
          </label>
          <form method="dialog"><button class="btn btn-secondary btn-block">{f.ahoraNo}</button></form>
        </dialog>
      </figure>

      <form class="controls" data-config data-textos={JSON.stringify(textos)} onsubmit="return false">
        <fieldset class="step">
          <legend><span class="step-n">1</span> {t.tela}</legend>
          <div class="filters" role="group" aria-label={ui[lang].a11y.filtrar}>
            <button type="button" class="chip" aria-pressed="true" data-filter="todas">{t.todas}</button>
            <button type="button" class="chip" aria-pressed="false" data-filter="nueva">{t.novedades}</button>
            {familias.map((id) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={id}>{t.familias[id]}</button>
            ))}
          </div>
          <div class="swatches">
            {telas.map((tela, i) => (
              <label class="swatch" data-familia={tela.familia} data-nueva={tela.nueva ? 'true' : 'false'}>
                <input
                  type="radio"
                  name="tela"
                  value={tela.slug}
                  checked={tela === inicial.tela}
                  data-nombre={tela.nombre}
                  data-src={grandes[i].src}
                />
                <span class="swatch-img">
                  <Image src={tela.imagen} alt="" width={160} height={160} quality={72} loading="lazy" />
                  {tela.nueva && <span class="badge">{t.nueva}</span>}
                </span>
                <span class="swatch-name">{tela.nombre}</span>
              </label>
            ))}
          </div>
          <p class="hint">{t.masTelas}</p>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">2</span> {t.medida} <span class="legend-note">{t.medidaNota}</span></legend>
          <div class="options sizes">
            {tamanos.map((tam) => (
              <label class="option">
                <input
                  type="radio"
                  name="tamano"
                  value={tam.medida}
                  checked={tam === inicial.tamano}
                  data-precio={tam.precio}
                  data-ancho={tam.ancho}
                  data-alto={tam.alto}
                />
                <span class="option-body">
                  <span>{tam.medida}</span>
                  <span class="option-price">{euros(tam.precio)}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="hint">{t.aMedida}</p>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">3</span> {t.marco}</legend>
          <div class="options frames-opts">
            {marcos.map((m) => (
              <label class="option">
                <input type="radio" name="marco" value={m.id} checked={m === inicial.marco} data-nombre={marcoNombre(m.id)} data-color={m.color ?? ''} />
                <span class="option-body">
                  <span class="wood" style={m.color ? `--c:${m.color}` : undefined} data-none={!m.color}></span>
                  <span>{marcoNombre(m.id)}</span>
                  <span class="option-price">{m.color ? `+${euros(enmarcado.precio)}` : t.incluido}</span>
                </span>
              </label>
            ))}
          </div>
          <label class="toggle">
            <input type="checkbox" name="diptico" role="switch" />
            <span class="toggle-track" aria-hidden="true"></span>
            <span>
              <strong>{t.diptico}</strong>
              <span class="toggle-note">{t.dipticoNota(pct)}</span>
            </span>
          </label>
        </fieldset>

        <div class="summary">
          <dl class="breakdown" data-breakdown>
            <div><dt>{t.tapiz} {inicial.tamano.medida}</dt><dd>{euros(inicial.tamano.precio)}</dd></div>
            <div><dt>{marcoNombre(inicial.marco.id)}</dt><dd>+{euros(enmarcado.precio)}</dd></div>
          </dl>
          <p class="total">
            <span>{t.total}</span>
            <output data-total>{euros(precioInicial)}</output>
          </p>
          <a class="btn btn-primary btn-block" href={contacto.whatsapp} data-whatsapp target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            {t.pedir}
          </a>
          <button type="button" class="btn btn-secondary btn-block" data-compartir>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 15V3.5m0 0L7.5 8M12 3.5 16.5 8M6 11.5H5a1 1 0 0 0-1 1V20a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7.5a1 1 0 0 0-1-1h-1"/></svg>
            {t.compartir}
          </button>
          <p class="hint">{t.nota}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { estancias, colocar, medidasColgado, A4 } from '../data/estancias';
  import { imagenDiseno } from '../scripts/imagen-diseno';

  const form = document.querySelector<HTMLFormElement>('[data-config]');
  const frames = document.querySelector<HTMLElement>('[data-frames]');
  if (form && frames) {
    const ENMARCADO = 30;
    const DESCUENTO = 0.25;
    const WHATSAPP = 'https://wa.me/34634264135';
    const textos = JSON.parse(form.dataset.textos!) as {
      intl: string; marca: string; tapiz: string; diptico: string; segundo: string; mensajes: Record<string, string>;
    };
    const fmt = new Intl.NumberFormat(textos.intl, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const euros = (n: number) => fmt.format(Math.round(n));
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const nombre = $('[data-out-nombre]');
    const detalle = $('[data-out-detalle]');
    const breakdown = $('[data-breakdown]');
    const total = $('[data-total]');
    const precio = $('[data-out-precio]');
    const cta = $<HTMLAnchorElement>('[data-whatsapp]');
    const fabrics = frames.querySelectorAll<HTMLImageElement>('[data-fabric]');

    const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!;

    const update = () => {
      const tela = checked('tela');
      const tamano = checked('tamano');
      const marco = checked('marco');
      const esDiptico = form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked;

      const base = Number(tamano.dataset.precio);
      const conMarco = marco.value !== 'sin';
      const unidad = base + (conMarco ? ENMARCADO : 0);
      const segundo = esDiptico ? unidad * (1 - DESCUENTO) : 0;

      fabrics.forEach((img) => { if (img.getAttribute('src') !== tela.dataset.src) img.src = tela.dataset.src!; });
      frames.style.setProperty('--w', tamano.dataset.ancho!);
      frames.style.setProperty('--h', tamano.dataset.alto!);
      frames.style.setProperty('--frame', marco.dataset.color || 'transparent');
      frames.dataset.marco = marco.value;
      frames.dataset.diptico = String(esDiptico);

      nombre.textContent = tela.dataset.nombre!;
      detalle.textContent = `${esDiptico ? `${textos.diptico} · ` : ''}${tamano.value} cm · ${marco.dataset.nombre}`;

      const filas: [string, string][] = [[`${textos.tapiz} ${tamano.value}`, euros(base)]];
      if (conMarco) filas.push([marco.dataset.nombre!, `+${euros(ENMARCADO)}`]);
      if (esDiptico) filas.push([textos.segundo, `+${euros(segundo)}`]);
      breakdown.replaceChildren(
        ...filas.map(([dt, dd]) => {
          const row = document.createElement('div');
          row.append(Object.assign(document.createElement('dt'), { textContent: dt }), Object.assign(document.createElement('dd'), { textContent: dd }));
          return row;
        })
      );
      total.textContent = precio.textContent = euros(unidad + segundo);

      const mensaje = textos.mensajes[`${esDiptico}-${conMarco}`]
        .replace('{tela}', tela.dataset.nombre!)
        .replace('{medida}', tamano.value)
        .replace('{marco}', marco.dataset.nombre!.toLowerCase())
        .replace('{MARCO}', marco.dataset.nombre!);
      cta.href = `${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
      colgar();
    };

    // Coloca el tapiz en la foto de la estancia, a escala y sin tapar lámparas ni jarrones
    const wall = $<HTMLElement>('[data-wall]');
    const colgado = () => {
      const tamano = checked('tamano');
      return medidasColgado(
        Number(tamano.dataset.ancho),
        Number(tamano.dataset.alto),
        checked('marco').value !== 'sin',
        form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked
      );
    };
    const colgar = () => {
      const fondo = document.querySelector<HTMLInputElement>('input[name="fondo"]:checked')!.value;
      wall.dataset.room = fondo;
      if (fondo === 'foto') return pintarFoto();
      const foto = estancias.find((e) => e.id === fondo)?.foto;
      if (!foto) return;
      const { ancho, alto } = colgado();
      const sitio = colocar(foto, ancho, alto);
      wall.style.setProperty('--fx', String(sitio.x));
      wall.style.setProperty('--fb', String(sitio.abajo));
      wall.style.setProperty('--fcm', String(sitio.cm));
      wall.style.setProperty('--y0', String(sitio.y0));
      wall.style.setProperty('--cy', String(sitio.cy));
    };

    // Tu pared: la foto del cliente, que no sale del navegador. Un folio A4 pegado en la pared da la escala.
    // Todo se guarda en fracciones de la foto: el folio (fu, fv, fw) y el centro del tapiz (u, v).
    const miFoto = $<HTMLImageElement>('[data-mi-foto]');
    const folio = $<HTMLElement>('[data-folio]');
    const guia = $<HTMLDialogElement>('[data-guia]');
    const ayuda = $<HTMLElement>('[data-foto-ayuda]');
    const textoMover = ayuda.textContent!;
    const ANCHO_SIN_FOLIO = 300; // cm de pared que suponemos en la foto si no hay folio
    const pared = { fu: 0.5, fv: 0.45, fw: 0.1, u: 0.5, v: 0.45, anchoCm: ANCHO_SIN_FOLIO };
    const limitar = (n: number, min: number, max: number) => Math.min(Math.max(n, min), max);

    // Dónde se pinta la foto en la pared: entera mientras se ajusta el folio, y a sangre centrada en él después
    const encaje = () => {
      const entera = wall.dataset.foto === 'calibrando';
      const sw = wall.clientWidth;
      const sh = wall.clientHeight;
      const s = (entera ? Math.min : Math.max)(sw / miFoto.naturalWidth, sh / miFoto.naturalHeight);
      const w = miFoto.naturalWidth * s;
      const h = miFoto.naturalHeight * s;
      const lado = (hueco: number, mide: number, f: number) =>
        entera ? (hueco - mide) / 2 : limitar(hueco / 2 - f * mide, hueco - mide, 0);
      return { x: lado(sw, w, pared.fu), y: lado(sh, h, pared.fv), w, h, sw, sh };
    };

    const pintarFoto = () => {
      if (!wall.dataset.foto || !miFoto.naturalWidth) return;
      const r = encaje();
      Object.assign(miFoto.style, { left: `${r.x}px`, top: `${r.y}px`, width: `${r.w}px`, height: `${r.h}px` });
      if (wall.dataset.foto === 'calibrando') {
        const w = pared.fw * r.w;
        const h = (w * A4.alto) / A4.ancho;
        Object.assign(folio.style, {
          left: `${r.x + pared.fu * r.w - w / 2}px`, top: `${r.y + pared.fv * r.h - h / 2}px`, width: `${w}px`, height: `${h}px`,
        });
        return;
      }
      const cm = r.w / pared.anchoCm;
      const centroY = r.y + pared.v * r.h;
      wall.style.setProperty('--fx', String(((r.x + pared.u * r.w) / r.sw) * 100));
      wall.style.setProperty('--fcm', String((cm / r.sw) * 100));
      wall.style.setProperty('--fb', String(((r.sh - centroY - (colgado().alto * cm) / 2) / r.sh) * 100));
    };
    new ResizeObserver(pintarFoto).observe(wall);

    // Arrastre con el dedo o el ratón; mover recibe el desplazamiento y el evento
    const arrastrar = (el: HTMLElement, puede: () => boolean, mover: (dx: number, dy: number, e: PointerEvent) => void) => {
      el.addEventListener('pointerdown', (e) => {
        if (!puede()) return;
        e.preventDefault();
        e.stopPropagation();
        el.setPointerCapture(e.pointerId);
        let px = e.clientX;
        let py = e.clientY;
        wall.classList.add('arrastrando');
        const mv = (ev: PointerEvent) => { mover(ev.clientX - px, ev.clientY - py, ev); px = ev.clientX; py = ev.clientY; };
        const fin = () => {
          el.removeEventListener('pointermove', mv);
          el.removeEventListener('pointerup', fin);
          el.removeEventListener('pointercancel', fin);
          wall.classList.remove('arrastrando');
          anticipar();
        };
        el.addEventListener('pointermove', mv);
        el.addEventListener('pointerup', fin);
        el.addEventListener('pointercancel', fin);
      });
    };
    arrastrar(folio, () => true, (dx, dy) => {
      const r = encaje();
      pared.fu = limitar(pared.fu + dx / r.w, 0, 1);
      pared.fv = limitar(pared.fv + dy / r.h, 0, 1);
      pintarFoto();
    });
    // La esquina estira el folio desde su centro, sin perder la proporción del A4
    arrastrar($('[data-esquina]'), () => true, (_dx, _dy, e) => {
      const r = encaje();
      const caja = wall.getBoundingClientRect();
      const cx = caja.left + r.x + pared.fu * r.w;
      const cy = caja.top + r.y + pared.fv * r.h;
      const mitad = Math.max(Math.abs(e.clientX - cx), (Math.abs(e.clientY - cy) * A4.ancho) / A4.alto);
      pared.fw = limitar((2 * mitad) / r.w, 0.01, 1);
      pintarFoto();
    });
    arrastrar(frames, () => wall.dataset.room === 'foto' && wall.dataset.foto === 'lista', (dx, dy) => {
      const r = encaje();
      pared.u = limitar(pared.u + dx / r.w, 0, 1);
      pared.v = limitar(pared.v + dy / r.h, 0, 1);
      pintarFoto();
    });

    const colocarEnFoto = (conFolio: boolean) => {
      pared.anchoCm = conFolio ? A4.ancho / pared.fw : ANCHO_SIN_FOLIO;
      pared.u = pared.fu;
      pared.v = pared.fv;
      ayuda.textContent = conFolio ? textoMover : ayuda.dataset.aprox!;
      ayuda.toggleAttribute('data-aviso', !conFolio);
      wall.dataset.foto = 'lista';
      pintarFoto();
      anticipar();
    };
    $('[data-listo]').addEventListener('click', () => colocarEnFoto(true));
    $('[data-sin-folio]').addEventListener('click', () => colocarEnFoto(false));
    $('[data-reajustar]').addEventListener('click', () => { wall.dataset.foto = 'calibrando'; pintarFoto(); });
    $('[data-cambiar]').addEventListener('click', () => guia.showModal());

    $<HTMLInputElement>('[data-archivo]').addEventListener('change', async (e) => {
      const input = e.currentTarget as HTMLInputElement;
      const archivo = input.files?.[0];
      input.value = '';
      if (!archivo) return;
      if (miFoto.src.startsWith('blob:')) URL.revokeObjectURL(miFoto.src);
      miFoto.src = URL.createObjectURL(archivo);
      await miFoto.decode().catch(() => {});
      Object.assign(pared, { fu: 0.5, fv: 0.45, fw: 0.1 });
      wall.dataset.foto = 'calibrando';
      guia.close();
      pintarFoto();
    });

    // Al elegir «Tu pared» sin foto se abre la guía; si se cierra sin foto, se vuelve a la estancia de antes
    let anterior = wall.dataset.room!;
    $('[data-rooms]').addEventListener('change', (e) => {
      const fondo = (e.target as HTMLInputElement).value;
      if (fondo !== 'foto') anterior = fondo;
      else if (!wall.dataset.foto) guia.showModal();
    });
    guia.addEventListener('close', () => {
      if (wall.dataset.foto) return;
      document.querySelector<HTMLInputElement>(`input[name="fondo"][value="${anterior}"]`)!.checked = true;
      colgar();
    });

    form.addEventListener('change', update);
    update();

    // Compartir el diseño como imagen: el menú del sistema si admite archivos, si no se descarga.
    // Safari solo deja abrir el menú justo después del toque, así que la imagen se prepara antes,
    // cuando el diseño lleva un momento sin cambiar (y han acabado las transiciones), y al pulsar
    // se comparte la que ya está hecha. Va sola, sin texto: WhatsApp e Instagram descartan la
    // imagen si la acompaña un texto, y la propia imagen ya lleva la marca y el teléfono.
    const compartir = $<HTMLButtonElement>('[data-compartir]');
    let lista: { clave: string; archivo: File } | null = null;
    let espera = 0;
    const clave = () => `${wall.dataset.room}|${wall.dataset.foto}|${miFoto.src}|${new FormData(form).toString()}|${wall.getAttribute('style')}`;
    const preparar = async () => {
      const c = clave();
      if (lista?.clave === c) return lista.archivo;
      const blob = await imagenDiseno(wall, {
        nombre: nombre.textContent!, detalle: detalle.textContent!, precio: total.textContent!, marca: textos.marca,
      });
      const slug = checked('tela').value;
      lista = { clave: c, archivo: new File([blob], `linum-${slug}.jpg`, { type: 'image/jpeg' }) };
      return lista.archivo;
    };
    const anticipar = () => {
      clearTimeout(espera);
      espera = window.setTimeout(() => { preparar().catch(() => {}); }, 500);
    };
    form.addEventListener('change', anticipar);
    $('[data-rooms]').addEventListener('change', anticipar);
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { anticipar(); o.disconnect(); } }).observe(compartir);

    compartir.addEventListener('click', async () => {
      const archivo = lista?.clave === clave() ? lista.archivo : await preparar();
      const datos = { files: [archivo] };
      if (navigator.canShare?.(datos)) {
        try { await navigator.share(datos); return; }
        catch (e) { if ((e as Error).name === 'AbortError') return; }
      }
      const url = URL.createObjectURL(archivo);
      Object.assign(document.createElement('a'), { href: url, download: archivo.name }).click();
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
    });

    $('[data-rooms]').addEventListener('change', colgar);

    // En móvil las telas van en una tira horizontal: deja a la vista la elegida
    const tira = $<HTMLElement>('.swatches');
    const elegida = checked('tela').closest<HTMLElement>('.swatch')!;
    tira.scrollLeft = elegida.offsetLeft - tira.clientWidth / 2 + elegida.offsetWidth / 2;

    const swatches = form.querySelectorAll<HTMLElement>('.swatch');
    form.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn, _, all) => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        swatches.forEach((s) => {
          s.hidden = !(f === 'todas' || (f === 'nueva' ? s.dataset.nueva === 'true' : s.dataset.familia === f));
        });
        tira.scrollLeft = 0;
      });
    });
  }
</script>

<style>
  .config { background: var(--raised); border-block: 1px solid var(--rule); }
