---
import { Image, getImage } from 'astro:assets';
import { telas, familias, tamanos, marcos, enmarcado, diptico, contacto, cuadrito, type Producto } from '../data/estudio';
import { estancias, colocar, medidasColgado, MOLDURA, SEPARACION_DIPTICO } from '../data/estancias';
import Estancias from './Estancias.astro';
import { ui, idiomas, euros as eur, type Lang } from '../i18n/ui';

interface Props { lang: Lang; producto: Producto }
const { lang, producto } = Astro.props;
const esCuadrito = producto === 'cuadrito';
const t = ui[lang].config;
const f = t.foto;
const a = t.ar;
const c = t.cuadrito;
const pct = diptico.descuento * 100;

const grandes = await Promise.all(
  telas.map((t) => getImage({ src: t.imagen, width: 900, format: 'webp', quality: 80 }))
);

// Cuadritos: la tela de fondo se ve entera y el diseño, en la lámina del centro
const grandesCuadrito = await Promise.all(
  cuadrito.telas.map((t) => getImage({ src: t.imagen, width: 600, format: 'webp', quality: 80 }))
);
const disenos = await Promise.all(
  cuadrito.disenos.map((d) => getImage({ src: d.imagen, width: 700, format: 'webp', quality: 82 }))
);
const natural = marcos.find((m) => m.id === 'natural')!;

const inicial = { tela: telas.find((t) => t.slug === 'tanger') ?? telas[0], tamano: tamanos[2], marco: marcos[1] };
const precioInicial = inicial.tamano.precio + enmarcado.precio;
const euros = (n: number) => eur(lang, n);
const marcoNombre = (id: (typeof marcos)[number]['id']) => t.marcos[id];
const numero = new Intl.NumberFormat(idiomas[lang].intl, { maximumFractionDigits: 1 });

const impresion0 = cuadrito.impresiones[0];
const salida = esCuadrito
  ? {
      nombre: c.disenos[cuadrito.disenos[0].slug],
      detalle: `${c.telas[cuadrito.telas[0].slug]} · ${c.impresiones[impresion0.id]} · ${cuadrito.medida} cm`,
      precio: euros(impresion0.precio),
      filas: [[`${c.nombre} ${cuadrito.medida} · ${c.impresiones[impresion0.id]}`, euros(impresion0.precio)]],
      pedir: c.pedir,
    }
  : {
      nombre: inicial.tela.nombre,
      detalle: `${inicial.tamano.medida} cm · ${marcoNombre(inicial.marco.id)}`,
      precio: euros(precioInicial),
      filas: [[`${t.tapiz} ${inicial.tamano.medida}`, euros(inicial.tamano.precio)], [marcoNombre(inicial.marco.id), `+${euros(enmarcado.precio)}`]],
      pedir: t.pedir,
    };

// Plantillas del mensaje de WhatsApp para el script: {tela}, {medida} y el marco ({marco} en minúsculas, {MARCO} tal cual)
const textos = {
  intl: idiomas[lang].intl,
  marca: `Linum Estudio · ${contacto.instagramUser} · ${contacto.telefono}`,
  tapiz: t.tapiz,
  diptico: t.diptico,
  segundo: t.segundo(pct),
  mensajes: Object.fromEntries(
    [true, false].flatMap((d) => [true, false].map((m) => [
      `${d}-${m}`,
      t.mensaje({ diptico: d, tela: '{tela}', medida: '{medida}', marco: m ? '{MARCO}' : null }),
    ]))
  ),
  pedir: t.pedir,
  enmarcado: enmarcado.precio,
  descuento: diptico.descuento,
  foto: { abarca: f.abarca, raro: f.raro, mover: f.mover, aprox: f.aprox, intl: idiomas[lang].intl },
  // Cuadrito: medidas por dentro del marco, que es siempre de madera natural; un mensaje por impresión con {diseno} y {tela}
  cuadrito: {
    nombre: c.nombre,
    medida: cuadrito.medida,
    ancho: cuadrito.ancho - 2 * cuadrito.moldura,
    alto: cuadrito.alto - 2 * cuadrito.moldura,
    moldura: cuadrito.moldura,
    marco: natural.color,
    pedir: c.pedir,
    mensajes: Object.fromEntries(
      cuadrito.impresiones.map((i) => [i.id, c.mensaje({ diseno: '{diseno}', tela: '{tela}', impresion: c.impresiones[i.id] })])
    ),
  },
};
const maxAlto = Math.max(...tamanos.map((t) => t.alto));
// El cuadrito, tan pequeño, solo se ve de cerca: no se elige estancia
const estanciaInicial = esCuadrito ? estancias.find((e) => e.id === 'cerca')! : estancias[1];
const colgadoInicial = esCuadrito
  ? medidasColgado(cuadrito.ancho - 2 * cuadrito.moldura, cuadrito.alto - 2 * cuadrito.moldura, true, false, cuadrito.moldura)
  : medidasColgado(inicial.tamano.ancho, inicial.tamano.alto, inicial.marco.id !== 'sin', false);
// De cerca no hay foto: la colocación queda lista para cuando haya estancia
const sitioInicial = colocar((estanciaInicial.foto ?? estancias[1].foto)!, colgadoInicial.ancho, colgadoInicial.alto);
---
<section id="configurador" class="section config" aria-labelledby="config-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{esCuadrito ? c.eyebrow : t.eyebrow}</p>
      <h2 id="config-title">{esCuadrito ? c.titulo : t.titulo}</h2>
      <p class="lede">{esCuadrito ? c.lede : t.lede}</p>
    </header>

    <div class="config-grid">
      <figure class="preview">
        <div
          class="wall"
          data-wall
          data-room={estanciaInicial.id}
          style={`--fx:${sitioInicial.x};--fb:${sitioInicial.abajo};--fcm:${sitioInicial.cm};--y0:${sitioInicial.y0};--dx:0;--moldura:${MOLDURA};--mc:${cuadrito.moldura};--separacion:${SEPARACION_DIPTICO}`}
        >
          <div class="scene">
          <Estancias inicial={estanciaInicial.id} />
          <img class="mi-foto" data-estancia="foto" data-mi-foto alt="" draggable="false" />
          <div
            class="frames"
            data-frames
            data-diptico="false"
            style={`--w:${inicial.tamano.ancho};--h:${inicial.tamano.alto};--max:${maxAlto};--frame:${inicial.marco.color}`}
            data-marco={esCuadrito ? 'natural' : inicial.marco.id}
            data-producto={producto}
            data-impresion={cuadrito.impresiones[0].id}
          >
            <span class="tp-etiqueta" data-tp-etiqueta aria-hidden="true"></span>
            {[0, 1].map((i) => (
              <div class="frame" data-frame={i}>
                <div class="lienzo">
                  <img
                    src={esCuadrito ? grandesCuadrito[0].src : grandes[telas.indexOf(inicial.tela)].src}
                    alt=""
                    width="900"
                    height="900"
                    decoding="async"
                    data-fabric
                  />
                  <div class="lamina"><img src={disenos[0].src} alt="" decoding="async" loading="lazy" data-diseno /></div>
                </div>
              </div>
            ))}
          </div>
          <div class="floor" aria-hidden="true"></div>
          </div>
          <!-- Tu pared: guía del paso 1, medida del paso 2 y ayudas del paso 3 -->
          <svg class="tp-dibujo" viewBox="0 0 320 170" aria-hidden="true">
            <rect width="320" height="170" rx="12" class="g-pared" />
            <rect y="146" width="320" height="24" class="g-suelo" />
            <rect x="122" y="30" width="76" height="56" rx="2" class="g-tapiz" />
            <path d="M78 146v-30a10 10 0 0 1 10-10h144a10 10 0 0 1 10 10v30" class="g-sofa" />
            <rect x="68" y="118" width="184" height="28" rx="8" class="g-sofa" />
            <path d="M68 100h184" class="g-medida" />
            <circle cx="68" cy="100" r="6" class="g-punto" /><circle cx="252" cy="100" r="6" class="g-punto" />
          </svg>
          <div class="tp-medida" data-tp-medida>
            <svg class="tp-lineas" aria-hidden="true"><line class="tp-linea-fondo" data-tp-linea /><line class="tp-linea" data-tp-linea /></svg>
            <span class="tp-cota" data-tp-cota aria-hidden="true"></span>
            <button type="button" class="tp-punto" data-tp-punto="a" aria-label={`${f.punto} 1`}></button>
            <button type="button" class="tp-punto" data-tp-punto="b" aria-label={`${f.punto} 2`}></button>
            <div class="tp-lupa" data-tp-lupa aria-hidden="true"></div>
          </div>
          <button type="button" class="tp-flecha tp-flecha-ant" data-tp-flecha="-1" aria-label={f.anterior}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
          <button type="button" class="tp-flecha tp-flecha-sig" data-tp-flecha="1" aria-label={f.siguiente}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
          <p class="tp-aviso" data-tp-aviso hidden><span data-tp-aviso-texto></span><button type="button" class="foto-btn" data-tp-ir="medir" hidden>{f.medir}</button></p>
          <div class="foto-barra foto-acciones">
            <button type="button" class="foto-btn" data-tp-pantalla>{f.pantalla}</button>
            <button type="button" class="foto-btn" data-tp-ir="foto">{f.cambiar}</button>
          </div>
          <!-- Accesos directos sobre la vista previa -->
          <div class="tp-ctas">
            {!esCuadrito && (
              <button type="button" class="tp-cta" data-tp-abrir title={f.probarNota}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5A1.5 1.5 0 0 1 5.5 7h2l1.5-2h6l1.5 2h2A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z" /><circle cx="12" cy="13" r="3.5" /></svg>
                <span><strong>{f.probar}</strong><small>{f.probarNota}</small></span>
              </button>
            )}
            <button type="button" class="tp-cta" data-ar-abrir title={a.nota}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z" /><path d="M4 7.5l8 4.5 8-4.5M12 12v9" /></svg>
              <span><strong>{a.boton}</strong><small>{a.nota}</small></span>
            </button>
          </div>
        </div>
        <figcaption class="preview-caption" aria-live="polite">
          <span class="preview-name" data-out-nombre>{salida.nombre}</span>
          <span data-out-detalle>{salida.detalle}</span>
          <span class="preview-price" data-out-precio>{salida.precio}</span>
        </figcaption>
        <fieldset class="rooms" data-rooms hidden={esCuadrito}>
          <legend>{t.verEn} <span class="rooms-note">· {t.escala}</span></legend>
          <div class="room-chips">
            {estancias.map((e) => (
              <label class="room-chip">
                <input
                  type="radio"
                  name="fondo"
                  value={e.id}
                  checked={e === estanciaInicial}
                />
                <span>{t.estancias[e.id]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        {!esCuadrito && (
          <header class="tp-cabecera">
            <p class="tp-titulo">{f.titulo}</p>
            <ol class="tp-pasos">
              {f.pasos.map((p, i) => <li data-tp-paso-n={['foto', 'medir', 'colocar'][i]}><span>{i + 1}</span> {p}</li>)}
            </ol>
            <button type="button" class="tp-cerrar" data-tp-cerrar aria-label={f.cerrar}>×</button>
          </header>
          <div class="tp-panel">
            <section data-tp-seccion="foto">
              <h3>{f.fotoTitulo}</h3>
              <p>{f.fotoTexto}</p>
              <div class="tp-botones">
                <label class="btn btn-primary"><input type="file" accept="image/*" capture="environment" data-tp-archivo />{f.hacer}</label>
                <label class="btn btn-secondary"><input type="file" accept="image/*" data-tp-archivo />{f.galeria}</label>
                <button type="button" class="btn btn-secondary" data-tp-ultima hidden>{f.ultima}</button>
              </div>
              <details class="tp-consejos">
                <summary>{f.consejos}</summary>
                <ul>{f.consejosLista.map((c) => <li>{c}</li>)}</ul>
              </details>
              <p class="hint">{f.privacidad}</p>
            </section>
            <section data-tp-seccion="medir">
              <h3>{f.medirTitulo}</h3>
              <p>{f.medirTexto}</p>
              <div class="tp-refs">
                {f.referencias.map(([nombre, cm]) => (
                  <button type="button" class="chip" data-tp-ref={String(cm)} aria-pressed="false">{nombre} · {numero.format(cm)} cm</button>
                ))}
              </div>
              <label class="tp-cm">
                <span>{f.mide}</span>
                <input type="number" inputmode="decimal" min="1" max="5000" step="0.1" data-tp-cm />
                <span>cm</span>
              </label>
              <p class="tp-abarca" data-tp-abarca aria-live="polite"></p>
              <div class="tp-botones">
                <button type="button" class="btn btn-secondary" data-tp-sin-medida>{f.sinMedida}</button>
                <button type="button" class="btn btn-primary" data-tp-colocar disabled>{f.colocar}</button>
              </div>
            </section>
            <section data-tp-seccion="colocar">
              <div class="tp-tira" role="group" aria-label={t.tela}>
                {telas.map((tela) => (
                  <button type="button" class="tp-tela" data-tp-elegir="tela" data-valor={tela.slug} aria-label={tela.nombre} title={tela.nombre}>
                    <Image src={tela.imagen} alt="" width={160} height={160} quality={72} loading="lazy" />
                  </button>
                ))}
              </div>
              <div class="tp-chips" role="group" aria-label={t.medida}>
                {tamanos.map((tam) => <button type="button" class="chip" data-tp-elegir="tamano" data-valor={tam.medida}>{tam.medida}</button>)}
              </div>
              <div class="tp-chips" role="group" aria-label={t.marco}>
                {marcos.map((m) => <button type="button" class="chip" data-tp-elegir="marco" data-valor={m.id}>{marcoNombre(m.id)}</button>)}
                <button type="button" class="chip" data-tp-diptico>{t.diptico}</button>
              </div>
              <div class="tp-botones tp-acciones">
                <button type="button" class="btn btn-secondary" data-tp-compartir>{t.compartir}</button>
                <a class="btn btn-primary" data-tp-pedir href={contacto.whatsapp} target="_blank" rel="noopener">{f.pedir} · <span data-tp-precio></span></a>
              </div>
              <div class="tp-enlaces">
                <button type="button" data-tp-ir="medir">{f.medirOtraVez}</button>
                <button type="button" data-tp-ir="foto">{f.cambiar}</button>
              </div>
            </section>
          </div>
        )}
        <dialog class="ar-dialogo" data-ar data-titulo={a.titulo} data-titulo-cuadrito={a.tituloCuadrito} aria-labelledby="ar-titulo">
          <header class="ar-cabecera">
            <div>
              <h3 id="ar-titulo" data-ar-titulo>{a.titulo}</h3>
              <p class="ar-nombre" data-ar-nombre></p>
            </div>
            <form method="dialog"><button class="ar-cerrar" aria-label={a.cerrar}>×</button></form>
          </header>
          <div class="ar-visor" data-ar-visor><p class="ar-cargando" aria-live="polite">{a.cargando}</p></div>
          <p class="hint ar-girar">{a.girar}</p>
          <div class="ar-movil">
            <button type="button" class="btn btn-primary btn-block" data-ar-activar>{a.abrir}</button>
            <p class="hint">{a.ayuda}</p>
          </div>
          <p class="ar-no" data-ar-no hidden>{a.noDisponible}</p>
          {!esCuadrito && <button type="button" class="btn btn-secondary btn-block" data-ar-foto>{f.probar}</button>}
          <div class="ar-escritorio">
            <div class="ar-qr" data-ar-qr></div>
            <div>
              <h4>{a.qrTitulo}</h4>
              <p>{a.qrTexto}</p>
            </div>
          </div>
        </dialog>
      </figure>

      <form class="controls" data-config data-textos={JSON.stringify(textos)} onsubmit="return false">
        {!esCuadrito && (<>
        <fieldset class="step">
          <legend><span class="step-n">1</span> {t.tela}</legend>
          <div class="filters" role="group" aria-label={ui[lang].a11y.filtrar}>
            <button type="button" class="chip" aria-pressed="true" data-filter="todas">{t.todas}</button>
            <button type="button" class="chip" aria-pressed="false" data-filter="nueva">{t.novedades}</button>
            {familias.map((id) => (
              <button type="button" class="chip" aria-pressed="false" data-filter={id}>{t.familias[id]}</button>
            ))}
          </div>
          <div class="swatches">
            {telas.map((tela, i) => (
              <label class="swatch" data-familia={tela.familia} data-nueva={tela.nueva ? 'true' : 'false'}>
                <input
                  type="radio"
                  name="tela"
                  value={tela.slug}
                  checked={tela === inicial.tela}
                  data-nombre={tela.nombre}
                  data-src={grandes[i].src}
                />
                <span class="swatch-img">
                  <Image src={tela.imagen} alt="" width={160} height={160} quality={72} loading="lazy" />
                  {tela.nueva && <span class="badge">{t.nueva}</span>}
                </span>
                <span class="swatch-name">{tela.nombre}</span>
              </label>
            ))}
          </div>
          <p class="hint">{t.masTelas}</p>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">2</span> {t.medida} <span class="legend-note">{t.medidaNota}</span></legend>
          <div class="options sizes">
            {tamanos.map((tam) => (
              <label class="option">
                <input
                  type="radio"
                  name="tamano"
                  value={tam.medida}
                  checked={tam === inicial.tamano}
                  data-precio={tam.precio}
                  data-ancho={tam.ancho}
                  data-alto={tam.alto}
                />
                <span class="option-body">
                  <span>{tam.medida}</span>
                  <span class="option-price">{euros(tam.precio)}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="hint">{t.aMedida}</p>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">3</span> {t.marco}</legend>
          <div class="options frames-opts">
            {marcos.map((m) => (
              <label class="option">
                <input type="radio" name="marco" value={m.id} checked={m === inicial.marco} data-nombre={marcoNombre(m.id)} data-color={m.color ?? ''} />
                <span class="option-body">
                  <span class="wood" style={m.color ? `--c:${m.color}` : undefined} data-none={!m.color}></span>
                  <span>{marcoNombre(m.id)}</span>
                  <span class="option-price">{m.color ? `+${euros(enmarcado.precio)}` : t.incluido}</span>
                </span>
              </label>
            ))}
          </div>
          <label class="toggle">
            <input type="checkbox" name="diptico" role="switch" />
            <span class="toggle-track" aria-hidden="true"></span>
            <span>
              <strong>{t.diptico}</strong>
              <span class="toggle-note">{t.dipticoNota(pct)}</span>
            </span>
          </label>
        </fieldset>

        </>)}
        {esCuadrito && (<>
        <fieldset class="step">
          <legend><span class="step-n">1</span> {c.tela}</legend>
          <div class="swatches swatches-cuadrito">
            {cuadrito.telas.map((tela, i) => (
              <label class="swatch">
                <input
                  type="radio"
                  name="tela-cuadrito"
                  value={tela.slug}
                  checked={i === 0}
                  data-nombre={c.telas[tela.slug]}
                  data-src={grandesCuadrito[i].src}
                />
                <span class="swatch-img">
                  <Image src={tela.imagen} alt="" width={160} height={160} quality={72} loading="lazy" />
                </span>
                <span class="swatch-name">{c.telas[tela.slug]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">2</span> {c.diseno}</legend>
          <div class="swatches swatches-cuadrito disenos">
            {cuadrito.disenos.map((d, i) => (
              <label class="swatch">
                <input
                  type="radio"
                  name="diseno"
                  value={d.slug}
                  checked={i === 0}
                  data-nombre={c.disenos[d.slug]}
                  data-src={disenos[i].src}
                />
                <span class="swatch-img">
                  <Image src={d.imagen} alt="" width={160} quality={72} loading="lazy" />
                </span>
                <span class="swatch-name">{c.disenos[d.slug]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step">
          <legend><span class="step-n">3</span> {c.impresion} <span class="legend-note">{c.impresionNota}</span></legend>
          <div class="options impresiones">
            {cuadrito.impresiones.map((im, i) => (
              <label class="option">
                <input type="radio" name="impresion" value={im.id} checked={i === 0} data-nombre={c.impresiones[im.id]} data-precio={im.precio} />
                <span class="option-body">
                  <span>{c.impresiones[im.id]}</span>
                  <span class="option-price">{euros(im.precio)}</span>
                </span>
              </label>
            ))}
          </div>
          <p class="hint">{c.presupuesto}</p>
        </fieldset>
        </>)}

        <div class="summary">
          <dl class="breakdown" data-breakdown>
            {salida.filas.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
          </dl>
          <p class="total">
            <span>{t.total}</span>
            <output data-total>{salida.precio}</output>
          </p>
          <a class="btn btn-primary btn-block" href={contacto.whatsapp} data-whatsapp target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
            <span data-pedir>{salida.pedir}</span>
          </a>
          <button type="button" class="btn btn-secondary btn-block" data-compartir>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 15V3.5m0 0L7.5 8M12 3.5 16.5 8M6 11.5H5a1 1 0 0 0-1 1V20a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7.5a1 1 0 0 0-1-1h-1"/></svg>
            {t.compartir}
          </button>
          <p class="hint">{t.nota}</p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import { estancias, colocar, desplazamiento, medidasColgado, MOLDURA, SEPARACION_DIPTICO } from '../data/estancias';
  import { abrirAR, esMovil, type PiezaAR } from '../scripts/ar';
  import { imagenDiseno } from '../scripts/imagen-diseno';
  import { iniciarTuPared, type TextosFoto } from '../scripts/tu-pared';

  const form = document.querySelector<HTMLFormElement>('[data-config]');
  const frames = document.querySelector<HTMLElement>('[data-frames]');
  if (form && frames) {
    const WHATSAPP = 'https://wa.me/34634264135';
    const textos = JSON.parse(form.dataset.textos!) as {
      intl: string; marca: string; tapiz: string; diptico: string; segundo: string; mensajes: Record<string, string>; pedir: string;
      enmarcado: number; descuento: number; foto: TextosFoto;
      cuadrito: {
        nombre: string; medida: string; ancho: number; alto: number; moldura: number; marco: string; pedir: string;
        mensajes: Record<string, string>;
      };
    };
    // Precios del contenido (se cambian en el panel)
    const ENMARCADO = textos.enmarcado;
    const DESCUENTO = textos.descuento;
    const fmt = new Intl.NumberFormat(textos.intl, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const euros = (n: number) => fmt.format(Math.round(n));
    const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
    const nombre = $('[data-out-nombre]');
    const detalle = $('[data-out-detalle]');
    const breakdown = $('[data-breakdown]');
    const total = $('[data-total]');
    const precio = $('[data-out-precio]');
    const cta = $<HTMLAnchorElement>('[data-whatsapp]');
    const pedir = $('[data-pedir]');
    const fabrics = frames.querySelectorAll<HTMLImageElement>('[data-fabric]');
    const laminas = frames.querySelectorAll<HTMLImageElement>('[data-diseno]');
    const maxTapiz = frames.style.getPropertyValue('--max');

    const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!;
    const esCuadrito = () => frames.dataset.producto === 'cuadrito';
    const ponerSrc = (imgs: NodeListOf<HTMLImageElement>, src: string) =>
      imgs.forEach((img) => { if (img.getAttribute('src') !== src) img.src = src; });
    const pintarDesglose = (filas: [string, string][]) =>
      breakdown.replaceChildren(
        ...filas.map(([dt, dd]) => {
          const row = document.createElement('div');
          row.append(Object.assign(document.createElement('dt'), { textContent: dt }), Object.assign(document.createElement('dd'), { textContent: dd }));
          return row;
        })
      );

    // Cuadrito: medida fija y marco natural; se elige tela de fondo, diseño e impresión
    const updateCuadrito = () => {
      const c = textos.cuadrito;
      const tela = checked('tela-cuadrito');
      const diseno = checked('diseno');
      const impresion = checked('impresion');
      const importe = Number(impresion.dataset.precio);

      ponerSrc(fabrics, tela.dataset.src!);
      ponerSrc(laminas, diseno.dataset.src!);
      frames.style.setProperty('--w', String(c.ancho));
      frames.style.setProperty('--h', String(c.alto));
      frames.style.setProperty('--max', String(c.alto + 2 * c.moldura + 3));
      frames.style.setProperty('--frame', c.marco);
      Object.assign(frames.dataset, { marco: 'natural', diptico: 'false', producto: 'cuadrito', impresion: impresion.value });

      nombre.textContent = diseno.dataset.nombre!;
      detalle.textContent = `${tela.dataset.nombre} · ${impresion.dataset.nombre} · ${c.medida} cm`;
      pintarDesglose([[`${c.nombre} ${c.medida} · ${impresion.dataset.nombre}`, euros(importe)]]);
      total.textContent = precio.textContent = euros(importe);
      const mensaje = c.mensajes[impresion.value].replace('{diseno}', diseno.dataset.nombre!).replace('{tela}', tela.dataset.nombre!);
      cta.href = `${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
      pedir.textContent = c.pedir;
      colgar();
    };

    const update = () => {
      if (esCuadrito()) return updateCuadrito();
      const tela = checked('tela');
      const tamano = checked('tamano');
      const marco = checked('marco');
      const esDiptico = form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked;

      const base = Number(tamano.dataset.precio);
      const conMarco = marco.value !== 'sin';
      // El descuento del díptico es del segundo tapiz; cada tapiz lleva su marco a precio completo
      const piezas = esDiptico ? 2 : 1;
      const marcos = conMarco ? ENMARCADO * piezas : 0;
      const segundo = esDiptico ? base * (1 - DESCUENTO) : 0;

      ponerSrc(fabrics, tela.dataset.src!);
      frames.style.setProperty('--w', tamano.dataset.ancho!);
      frames.style.setProperty('--h', tamano.dataset.alto!);
      frames.style.setProperty('--max', maxTapiz);
      frames.style.setProperty('--frame', marco.dataset.color || 'transparent');
      Object.assign(frames.dataset, { marco: marco.value, diptico: String(esDiptico), producto: 'tapiz' });

      nombre.textContent = tela.dataset.nombre!;
      detalle.textContent = `${esDiptico ? `${textos.diptico} · ` : ''}${tamano.value} cm · ${marco.dataset.nombre}`;

      const filas: [string, string][] = [[`${textos.tapiz} ${tamano.value}`, euros(base)]];
      if (esDiptico) filas.push([textos.segundo, `+${euros(segundo)}`]);
      if (conMarco) filas.push([`${marco.dataset.nombre}${esDiptico ? ' × 2' : ''}`, `+${euros(marcos)}`]);
      pintarDesglose(filas);
      total.textContent = precio.textContent = euros(base + segundo + marcos);

      const mensaje = textos.mensajes[`${esDiptico}-${conMarco}`]
        .replace('{tela}', tela.dataset.nombre!)
        .replace('{medida}', tamano.value)
        .replace('{marco}', marco.dataset.nombre!.toLowerCase())
        .replace('{MARCO}', marco.dataset.nombre!);
      cta.href = `${WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
      pedir.textContent = textos.pedir;
      colgar();
      tuPared?.sincronizar();
    };

    // Coloca el tapiz en la foto de la estancia, a escala y sin tapar lámparas ni jarrones
    const wall = $<HTMLElement>('[data-wall]');
    let tuPared: ReturnType<typeof iniciarTuPared> | undefined;
    const colgado = () => {
      if (esCuadrito()) {
        const c = textos.cuadrito;
        return medidasColgado(c.ancho, c.alto, true, false, c.moldura);
      }
      const tamano = checked('tamano');
      return medidasColgado(
        Number(tamano.dataset.ancho),
        Number(tamano.dataset.alto),
        checked('marco').value !== 'sin',
        form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked
      );
    };
    const colgar = () => {
      const fondo = document.querySelector<HTMLInputElement>('input[name="fondo"]:checked')!.value;
      wall.dataset.room = fondo;
      if (fondo === 'foto') return tuPared?.pintar();
      const foto = estancias.find((e) => e.id === fondo)?.foto;
      if (!foto) return;
      const { ancho, alto } = colgado();
      const sitio = colocar(foto, ancho, alto);
      wall.style.setProperty('--fx', String(sitio.x));
      wall.style.setProperty('--fb', String(sitio.abajo));
      wall.style.setProperty('--fcm', String(sitio.cm));
      wall.style.setProperty('--y0', String(sitio.y0));
      wall.style.setProperty('--dx', String(desplazamiento(foto, wall.clientWidth / wall.clientHeight)));
    };

    new ResizeObserver(() => colgar()).observe(wall);

    // Tu pared: la foto del cliente, a pantalla completa (ver src/scripts/tu-pared.ts). Solo en los tapices.
    const miFoto = $<HTMLImageElement>('[data-mi-foto]');
    if (!esCuadrito()) {
      tuPared = iniciarTuPared({
        figura: wall.closest<HTMLElement>('.preview')!,
        wall,
        form,
        colgado,
        colgar,
        alCambiar: () => anticipar(),
        textos: textos.foto,
      });
    }

    // Llegada con una tela o un diseño elegidos (desde la portada o el código QR): ?tela=tanger&tamano=70×50&marco=natural&diptico=1, ?diseno=madre
    const params = new URLSearchParams(location.search);
    if (params.get('diptico') === '1') {
      const d = form.querySelector<HTMLInputElement>('input[name="diptico"]');
      if (d) d.checked = true;
    }
    for (const k of ['tela', 'tamano', 'marco', 'diseno', 'tela-cuadrito', 'impresion']) {
      const v = params.get(k);
      const input = v ? form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`) : null;
      if (!input) continue;
      input.checked = true;
      const tira = input.closest<HTMLElement>('.swatches');
      const label = input.closest<HTMLElement>('label');
      if (tira && label && tira.scrollWidth > tira.clientWidth) tira.scrollLeft = label.offsetLeft - tira.clientWidth / 2 + label.offsetWidth / 2;
    }

    form.addEventListener('change', update);
    update();

    // Verlo con la cámara (realidad aumentada): el modelo se hace con lo elegido; en el ordenador, un QR a esta misma configuración
    const dialogoAR = $<HTMLDialogElement>('[data-ar]');
    const piezaAR = (): PiezaAR => {
      if (esCuadrito()) {
        const c = textos.cuadrito;
        const diseno = checked('diseno');
        return {
          producto: 'cuadrito', tela: checked('tela-cuadrito').dataset.src!, diseno: diseno.dataset.src!,
          ancho: c.ancho, alto: c.alto, moldura: c.moldura, color: c.marco, diptico: false, separacion: 0,
          nombre: `${diseno.dataset.nombre} · ${c.medida} cm`,
        };
      }
      const tela = checked('tela');
      const tamano = checked('tamano');
      const marco = checked('marco');
      return {
        producto: 'tapiz', tela: tela.dataset.src!,
        ancho: Number(tamano.dataset.ancho), alto: Number(tamano.dataset.alto),
        moldura: marco.value === 'sin' ? 0 : MOLDURA, color: marco.dataset.color || null,
        diptico: form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked, separacion: SEPARACION_DIPTICO,
        nombre: `${tela.dataset.nombre} · ${tamano.value} cm`,
      };
    };
    const urlAR = () => {
      const q = new URLSearchParams();
      const nombres = esCuadrito() ? ['tela-cuadrito', 'diseno', 'impresion'] : ['tela', 'tamano', 'marco'];
      for (const n of nombres) q.set(n, checked(n).value);
      if (!esCuadrito() && form.querySelector<HTMLInputElement>('input[name="diptico"]')!.checked) q.set('diptico', '1');
      q.set('ver', 'ar');
      return `${location.origin}${location.pathname}?${q}#configurador`;
    };
    const verAR = () => abrirAR(dialogoAR, piezaAR(), urlAR());
    document.querySelectorAll('[data-ar-abrir]').forEach((b) => b.addEventListener('click', verAR));
    document.querySelector('[data-ar-foto]')?.addEventListener('click', () => {
      dialogoAR.close();
      tuPared?.abrir();
    });
    // Llegada desde el QR en el móvil: se abre directamente (el paso a la cámara necesita un toque)
    if (params.get('ver') === 'ar' && esMovil()) verAR();

    // Compartir el diseño como imagen: el menú del sistema si admite archivos, si no se descarga.
    // Safari solo deja abrir el menú justo después del toque, así que la imagen se prepara antes,
    // cuando el diseño lleva un momento sin cambiar, y al pulsar se comparte la que ya está hecha
    // si sigue siendo la de lo que se ve; si no, se hace en ese momento. Va sola, sin texto: WhatsApp e Instagram descartan la
    // imagen si la acompaña un texto, y la propia imagen ya lleva la marca y el teléfono.
    const compartir = $<HTMLButtonElement>('[data-compartir]');
    let lista: { clave: string; archivo: File } | null = null;
    let espera = 0;
    // Huella de lo que se ve: estancia, foto, elecciones del formulario y colocación del tapiz
    const clave = () =>
      [wall.dataset.room, wall.dataset.foto, miFoto.src, new URLSearchParams(new FormData(form) as never), wall.getAttribute('style')].join('|');
    // Se dibuja cuando el tapiz ha terminado de moverse o crecer, para no capturarlo a medio camino;
    // si algo cambia mientras se dibuja, se vuelve a hacer con lo nuevo
    const preparar = async (): Promise<File> => {
      await Promise.all(wall.getAnimations({ subtree: true }).map((a) => a.finished.catch(() => {})));
      const c = clave();
      if (lista?.clave === c) return lista.archivo;
      const blob = await imagenDiseno(wall, {
        nombre: nombre.textContent!, detalle: detalle.textContent!, precio: total.textContent!, marca: textos.marca,
      });
      if (clave() !== c) return preparar();
      const nombreArchivo = esCuadrito() ? `cuadrito-${checked('diseno').value}` : checked('tela').value;
      lista = { clave: c, archivo: new File([blob], `linum-${nombreArchivo}.jpg`, { type: 'image/jpeg' }) };
      return lista.archivo;
    };
    const anticipar = () => {
      clearTimeout(espera);
      espera = window.setTimeout(() => { preparar().catch(() => {}); }, 500);
    };
    form.addEventListener('change', anticipar);
    $('[data-rooms]').addEventListener('change', anticipar);
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { anticipar(); o.disconnect(); } }).observe(compartir);

    compartir.addEventListener('click', async () => {
      const archivo = lista?.clave === clave() ? lista.archivo : await preparar();
      const datos = { files: [archivo] };
      if (navigator.canShare?.(datos)) {
        try { await navigator.share(datos); return; }
        catch (e) { if ((e as Error).name === 'AbortError') return; }
      }
      const url = URL.createObjectURL(archivo);
      Object.assign(document.createElement('a'), { href: url, download: archivo.name }).click();
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
    });

    $('[data-rooms]').addEventListener('change', colgar);

    // En móvil las telas van en una tira horizontal: deja a la vista la elegida
    const tira = $<HTMLElement>('.swatches');
    const elegida = form.querySelector<HTMLInputElement>('.swatches input:checked')!.closest<HTMLElement>('.swatch')!;
    tira.scrollLeft = elegida.offsetLeft - tira.clientWidth / 2 + elegida.offsetWidth / 2;

    const swatches = form.querySelectorAll<HTMLElement>('.swatch[data-familia]');
    form.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn, _, all) => {
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter;
        all.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        swatches.forEach((s) => {
          s.hidden = !(f === 'todas' || (f === 'nueva' ? s.dataset.nueva === 'true' : s.dataset.familia === f));
        });
        tira.scrollLeft = 0;
      });
    });
  }
</script>

<style>
  .config { background: var(--raised); border-block: 1px solid var(--rule); }
  .config-grid { display: grid; gap: clamp(2rem, 1rem + 3vw, 4rem); align-items: start; }
  @media (min-width: 960px) {
    .config-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
    .preview { position: sticky; top: 6rem; }
  }

  /* —— Vista previa: la pared —— */
  .preview { margin: 0; display: grid; gap: 1rem; }
  .wall {
    /* Cuadrada en escritorio; en móvil es más baja y ancha, y se ve más foto a los lados */
    position: relative; aspect-ratio: 1; border-radius: var(--radius); overflow: hidden;
    background: var(--wall);
    container-type: size;
  }
  .scene {
    /* Cuadrada, como el recorte de las fotos de estancias: tan alta como la pared y centrada en ella
       (--dx la corre para no salirse de la foto). La foto de la estancia desborda la escena a los lados */
    position: absolute; top: 0; height: 100%; aspect-ratio: 1;
    left: calc(50cqw - 50cqh + var(--dx) * 100cqh);
    background:
      radial-gradient(120% 80% at 30% 0%, var(--wall-light), transparent 60%),
      var(--wall);
    display: grid; place-items: center; padding: 6% 6% 16%;
    container-type: size;
    transition: left 0.3s var(--ease);
  }
  .wall:is([data-room='cerca'], [data-room='foto']) .scene { left: 0; width: 100%; aspect-ratio: auto; }
  .floor {
    position: absolute; inset: auto 0 0 0; height: 14%;
    background: linear-gradient(color-mix(in oklab, var(--wall), black 10%), color-mix(in oklab, var(--wall), black 4%));
    border-top: 1px solid color-mix(in oklab, var(--wall), black 14%);
  }
  .frames {
    display: flex; gap: 5cqw; align-items: center; justify-content: center;
  }
  .frame {
    /* El tamaño visual es proporcional a la medida real, para comparar entre tamaños */
    height: calc(var(--h) / var(--max) * 80cqh);
    aspect-ratio: var(--w) / var(--h);
    padding: clamp(5px, 1.6%, 12px);
    background: var(--frame);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 18px 30px -12px rgb(40 30 20 / 0.45),
      0 4px 8px -4px rgb(40 30 20 / 0.3);
    transition: height 0.45s var(--ease), aspect-ratio 0.45s var(--ease), background-color 0.3s var(--ease), padding 0.3s var(--ease);
  }
  .frames[data-marco='sin'] .frame { padding: 0; }
  .frames[data-marco='blanca'] .frame { box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08), 0 18px 30px -12px rgb(40 30 20 / 0.4); }
  .lienzo { position: relative; width: 100%; height: 100%; container-type: size; }
  .lienzo > img { width: 100%; height: 100%; object-fit: cover; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12) inset; }

  /* —— Cuadrito: la lámina sobre la tela de fondo, con las proporciones de los cuadritos reales —— */
  .lamina {
    --papel: #f8f4ec;
    display: none; position: absolute; left: 50%; top: 47%; translate: -50% -50%;
    width: 47%; height: 47%;
    background: repeating-linear-gradient(90deg, rgb(120 100 70 / 0.05) 0 1px, transparent 1px 3px), var(--papel);
    box-shadow: 0 0.4cqw 0.9cqw rgb(40 30 20 / 0.28);
  }
  .lamina img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .frames[data-producto='cuadrito'] .lamina { display: block; }
  /* Impresa en tela: un retal de lino más grande, con los bordes deshilachados */
  .frames[data-impresion='tela'] .lamina {
    --lino: #ece2cf;
    --fleco: 2.2cqw;
    width: 54%; padding: 6% 8.5%;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.18) 0 1px, transparent 1px 2px),
      repeating-linear-gradient(90deg, rgb(110 90 60 / 0.07) 0 1px, transparent 1px 2px),
      var(--lino);
    box-shadow: 0 0.2cqw 0.5cqw rgb(40 30 20 / 0.18);
  }
  .frames[data-impresion='tela'] .lamina::before {
    content: ''; position: absolute; inset: calc(-1 * var(--fleco));
    --hilos-v: repeating-linear-gradient(90deg, var(--lino) 0 1px, transparent 1px 2.5px);
    --hilos-h: repeating-linear-gradient(0deg, var(--lino) 0 1px, transparent 1px 2.5px);
    background:
      var(--hilos-v) top / 100% var(--fleco) no-repeat,
      var(--hilos-v) bottom / 100% var(--fleco) no-repeat,
      var(--hilos-h) left / var(--fleco) 100% no-repeat,
      var(--hilos-h) right / var(--fleco) 100% no-repeat;
    opacity: 0.9;
  }
  .frames[data-diptico='false'] .frame[data-frame='1'] { display: none; }
  .frames[data-diptico='true'] .frame { height: calc(var(--h) / var(--max) * 64cqh); }
  /* De cerca, el cuadrito con su moldura a escala: --w y --h son por dentro del marco */
  .wall[data-room='cerca'] .frames[data-producto='cuadrito'] .frame {
    height: calc((var(--h) + 2 * var(--mc)) / var(--max) * 80cqh);
    aspect-ratio: calc(var(--w) + 2 * var(--mc)) / calc(var(--h) + 2 * var(--mc));
    padding: calc(var(--mc) / var(--max) * 80cqh);
  }

  /* —— Estancias: la foto marca la escala; --fcm es el % del recorte que mide 1 cm —— */
  .wall:not([data-room='cerca']) .scene { padding: 0; }
  .wall:not([data-room='cerca']) .floor { display: none; }
  .wall:not([data-room='cerca']) .frames {
    --m: var(--moldura);
    --cm: calc(var(--fcm) * 1cqw);
    position: absolute;
    left: calc(var(--fx) * 1cqw);
    bottom: calc(var(--fb) * 1cqh);
    translate: -50% 0;
    gap: calc(var(--separacion) * var(--cm)); align-items: flex-end;
    transition: left 0.3s var(--ease), bottom 0.3s var(--ease);
  }
  .wall:not([data-room='cerca']) .frames[data-marco='sin'] { --m: 0; }
  .wall:not([data-room='cerca']) .frames[data-producto='cuadrito'] { --m: var(--mc); }
  .wall:not([data-room='cerca']) .frame {
    width: calc((var(--w) + 2 * var(--m)) * var(--cm));
    height: calc((var(--h) + 2 * var(--m)) * var(--cm));
    aspect-ratio: auto;
    padding: calc(var(--m) * var(--cm));
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.2) inset, 0 3px 8px -2px rgb(30 20 10 / 0.35);
    transition: width 0.3s var(--ease), height 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  /* —— Tu pared: la foto del cliente, colocada por el script en px de la pared —— */
  .mi-foto { position: absolute; max-width: none; display: none; }
  .wall[data-room='foto'][data-foto] .mi-foto { display: block; }
  .wall[data-room='foto']:not([data-foto='lista']) .frames { display: none; }
  .wall[data-room='foto'] .frames { touch-action: none; cursor: grab; }
  .wall.arrastrando .frames { cursor: grabbing; }
  .wall.arrastrando :is(.frames, .frame, .mi-foto) { transition: none; }

  .foto-barra {
    position: absolute; inset: auto 0.5rem 0.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem;
    padding: 0.5rem 0.5rem 0.5rem 0.85rem; border-radius: 14px;
    background: color-mix(in oklab, var(--surface) 92%, transparent); backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px -6px rgb(0 0 0 / 0.3);
  }
  .foto-barra p { flex: 1 1 12rem; margin: 0; font-size: var(--step--1); line-height: 1.3; }
  .foto-btn {
    min-height: 40px; padding: 0 0.9rem; border-radius: 999px; border: 1px solid var(--rule);
    background: var(--surface); color: var(--ink); font: 500 var(--step--1) / 1 var(--font-body); cursor: pointer;
  }
  .foto-btn:hover { border-color: var(--ink-2); }
  .foto-btn-ok { background: var(--ink); border-color: var(--ink); color: var(--surface); }


  .g-sofa { fill: color-mix(in oklab, var(--wall), black 22%); }
  .g-pared { fill: var(--wall); }
  .g-suelo { fill: color-mix(in oklab, var(--wall), black 8%); }
  .g-tapiz { fill: #c39a6b; stroke: #fff; stroke-width: 2; }
  .g-medida { stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 6 4; }
  .g-punto { fill: #fff; stroke: var(--accent); stroke-width: 3; }

  /* —— Tu pared —— */
  .foto-acciones { display: none; }
  .wall[data-room='foto'][data-foto='lista'] .foto-acciones { display: flex; }
  .preview[data-inmersivo] .foto-acciones { display: none !important; }

  /* Accesos sobre la vista previa: probar en tu pared (y, en la fase 2, con la cámara) */
  .tp-ctas { position: absolute; left: 0.6rem; bottom: 0.6rem; z-index: 2; display: flex; flex-wrap: wrap; gap: 0.4rem; max-width: calc(100% - 1.2rem); }
  .tp-ctas:empty, .wall[data-room='foto'][data-foto='lista'] .tp-ctas, .preview[data-inmersivo] .tp-ctas { display: none; }
  .tp-cta {
    display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    border: 0; border-radius: 999px; cursor: pointer; text-align: left; color: var(--ink);
    background: color-mix(in oklab, var(--surface) 92%, transparent); backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px -6px rgb(0 0 0 / 0.35); font: 400 var(--step--1) / 1.2 var(--font-body);
  }
  .tp-cta:hover { background: var(--surface); }
  .tp-cta:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .tp-cta svg { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linejoin: round; }
  .tp-cta span { display: grid; }
  .tp-cta small { display: none; } /* el detalle va en el título (title) para no ocupar dos filas */

  /* Medida sobre la tela del tapiz */
  .tp-etiqueta {
    display: none; position: absolute; left: 50%; bottom: 100%; translate: -50% -8px; z-index: 1;
    padding: 0.25rem 0.6rem; border-radius: 999px; white-space: nowrap; pointer-events: none;
    background: rgb(25 22 19 / 0.78); color: #fff; font: 500 0.75rem / 1.2 var(--font-body); font-variant-numeric: lining-nums;
  }
  .wall[data-room='foto'][data-foto='lista'] .tp-etiqueta { display: block; }

  /* Paso 1: dibujo que explica la foto */
  .tp-dibujo { display: none; position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: min(80%, 26rem); height: auto; }
  .preview[data-paso='foto'] .tp-dibujo { display: block; }
  .preview[data-paso='foto'] :is(.mi-foto, .frames) { display: none !important; }

  /* Paso 2: los dos extremos de la medida, la línea y la lupa */
  .tp-medida { display: none; position: absolute; inset: 0; z-index: 2; touch-action: none; cursor: crosshair; }
  .wall[data-room='foto'][data-foto='midiendo'] .tp-medida { display: block; }
  .tp-lineas { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .tp-linea-fondo { stroke: rgb(0 0 0 / 0.55); stroke-width: 5; stroke-linecap: round; }
  .tp-linea { stroke: #fff; stroke-width: 2.5; stroke-dasharray: 9 6; stroke-linecap: round; }
  .tp-punto {
    position: absolute; width: 46px; height: 46px; translate: -50% -50%; padding: 0; border-radius: 50%; cursor: grab; touch-action: none;
    border: 3px solid #fff; background: rgb(59 86 54 / 0.3); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.45), 0 2px 10px rgb(0 0 0 / 0.4);
  }
  .tp-punto::after { content: ''; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; translate: -50% -50%; border-radius: 50%; background: #fff; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5); }
  .tp-punto:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .tp-cota {
    position: absolute; translate: -50% calc(-100% - 30px); padding: 0.35rem 0.7rem; border-radius: 999px; white-space: nowrap; pointer-events: none;
    background: var(--ink); color: #fff; font: 600 0.875rem / 1 var(--font-body); box-shadow: 0 2px 8px rgb(0 0 0 / 0.3);
  }
  .tp-lupa {
    display: none; position: absolute; z-index: 3; width: 120px; height: 120px; border-radius: 50%; pointer-events: none;
    border: 3px solid #fff; background-color: #222; background-repeat: no-repeat; box-shadow: 0 8px 24px rgb(0 0 0 / 0.5);
  }
  .tp-lupa::before, .tp-lupa::after { content: ''; position: absolute; background: rgb(255 255 255 / 0.9); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.4); }
  .tp-lupa::before { left: 50%; top: 30%; bottom: 30%; width: 1.5px; translate: -50% 0; }
  .tp-lupa::after { top: 50%; left: 30%; right: 30%; height: 1.5px; translate: 0 -50%; }

  /* Paso 3: aviso, flechas para cambiar de tela */
  .tp-aviso {
    display: none; position: absolute; bottom: 0.75rem; left: 50%; translate: -50% 0; z-index: 2; margin: 0; color: var(--ink); width: max-content;
    align-items: center; gap: 0.6rem; max-width: calc(100% - 1.2rem); padding: 0.4rem 0.45rem 0.4rem 0.9rem; border-radius: 999px;
    background: color-mix(in oklab, var(--surface) 92%, transparent); backdrop-filter: blur(8px);
    box-shadow: 0 4px 16px -6px rgb(0 0 0 / 0.35); font-size: var(--step--1); line-height: 1.25; pointer-events: none;
  }
  .tp-aviso:has(button:not([hidden])) { pointer-events: auto; }
  .tp-aviso:not(:has(button:not([hidden]))) { padding-right: 0.9rem; }
  .preview[data-inmersivo] .wall[data-room='foto'][data-foto='lista'] .tp-aviso:not([hidden]) { display: flex; }
  .tp-flecha {
    display: none; position: absolute; top: 50%; translate: 0 -50%; z-index: 2; width: 44px; height: 44px; padding: 0; place-items: center;
    border: 0; border-radius: 50%; cursor: pointer; background: rgb(255 255 255 / 0.85); color: var(--ink); box-shadow: 0 2px 10px rgb(0 0 0 / 0.3);
  }
  .tp-flecha svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .tp-flecha-ant { left: 0.6rem; }
  .tp-flecha-sig { right: 0.6rem; }
  .preview[data-inmersivo][data-paso='colocar'] .tp-flecha { display: grid; }

  /* —— Verlo con la cámara —— */
  .tp-ctas .tp-cta[data-ar-abrir] svg { stroke-linecap: round; }
  .ar-dialogo {
    width: min(100% - 2rem, 34rem); max-height: calc(100dvh - 2rem); padding: 1.25rem; overflow: auto;
    border: 0; border-radius: var(--radius); background: var(--surface); color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.45);
  }
  .ar-dialogo[open] { display: grid; gap: 0.85rem; }
  .ar-dialogo::backdrop { background: rgb(20 15 10 / 0.55); }
  .ar-cabecera { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .ar-cabecera h3 { margin: 0; font-size: var(--step-2); }
  .ar-nombre { margin: 0.25rem 0 0; color: var(--ink-2); font-size: var(--step--1); }
  .ar-cabecera form { margin: 0; }
  .ar-cerrar { width: 44px; height: 44px; margin: -0.5rem -0.5rem 0 0; border: 0; border-radius: 50%; background: transparent; color: var(--ink-2); font-size: 1.7rem; line-height: 1; cursor: pointer; }
  .ar-cerrar:hover { background: var(--raised); color: var(--ink); }
  .ar-visor { position: relative; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: radial-gradient(120% 90% at 50% 0%, var(--wall-light), var(--wall)); }
  .ar-visor :global(model-viewer) { width: 100%; height: 100%; --poster-color: transparent; }
  .ar-cargando { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--ink-2); font-size: var(--step--1); }
  .ar-dialogo:not([data-estado='cargando']) .ar-cargando { display: none; }
  .ar-girar { margin: -0.4rem 0 0; text-align: center; }
  .ar-dialogo[data-estado='cargando'] .ar-girar { visibility: hidden; }
  .ar-movil, .ar-escritorio { display: none; gap: 0.6rem; }
  .ar-dialogo[data-modo='movil'] .ar-movil { display: grid; }
  .ar-movil:has([data-ar-activar][hidden]) { display: none !important; }
  .ar-dialogo[data-modo='escritorio'] .ar-escritorio { display: grid; grid-template-columns: 9rem 1fr; gap: 1rem; align-items: center; }
  .ar-dialogo[data-modo='escritorio'] [data-ar-foto] { display: none; }
  .ar-qr { background: #fff; border-radius: 8px; padding: 0.25rem; line-height: 0; }
  .ar-qr :global(svg) { width: 100%; height: auto; }
  .ar-escritorio h4 { margin: 0 0 0.35rem; font: 500 var(--step-1) / 1.1 var(--font-display); }
  .ar-escritorio p, .ar-movil p, .ar-no { margin: 0; }
  .ar-no { padding: 0.75rem 1rem; border-radius: 10px; background: var(--raised); color: var(--ink-2); font-size: var(--step--1); }

  /* —— Pantalla completa —— */
  :global(html.tp-abierto) { overflow: hidden; }
  .tp-cabecera, .tp-panel { display: none; }
  .preview[data-inmersivo] {
    position: fixed; inset: 0; z-index: 1000; margin: 0; padding: 0; gap: 0; border: 0;
    height: 100dvh; background: #1b1815; color: #fff;
    display: grid; grid-template: 'cab' auto 'pared' minmax(0, 1fr) 'panel' auto / minmax(0, 1fr);
  }
  .preview[data-inmersivo] .wall { grid-area: pared; aspect-ratio: auto; height: 100%; border-radius: 0; background: #1b1815; touch-action: none; user-select: none; -webkit-user-select: none; }
  .mi-foto { -webkit-user-drag: none; }
  .preview[data-inmersivo] :is(.preview-caption, .rooms) { display: none; }
  .preview[data-inmersivo] .tp-cabecera {
    grid-area: cab; display: flex; align-items: center; gap: 1rem; padding: 0.5rem 0.5rem 0.5rem var(--gutter);
    padding-top: max(0.5rem, env(safe-area-inset-top));
  }
  .tp-titulo { margin: 0; font: 500 var(--step-1) / 1 var(--font-display); white-space: nowrap; }
  .tp-pasos { display: flex; gap: 0.35rem; margin: 0 auto; padding: 0; list-style: none; font-size: 0.8125rem; }
  .tp-pasos li { display: flex; align-items: center; gap: 0.35rem; padding: 0.3rem 0.65rem 0.3rem 0.35rem; border-radius: 999px; color: rgb(255 255 255 / 0.6); }
  .tp-pasos span { display: grid; place-items: center; width: 1.4rem; height: 1.4rem; border-radius: 50%; border: 1px solid currentColor; font-size: 0.75rem; }
  .tp-pasos li[aria-current] { color: #fff; background: rgb(255 255 255 / 0.12); }
  .tp-pasos li[aria-current] span { background: #fff; border-color: #fff; color: #1b1815; }
  .tp-cerrar {
    width: 44px; height: 44px; flex: none; border: 0; border-radius: 50%; background: transparent; color: #fff;
    font-size: 1.9rem; line-height: 1; cursor: pointer;
  }
  .tp-cerrar:hover { background: rgb(255 255 255 / 0.12); }
  .tp-cerrar:focus-visible { outline: 3px solid #fff; outline-offset: -3px; }

  .preview[data-inmersivo] .tp-panel {
    grid-area: panel; display: block; overflow-y: auto; max-height: 50dvh;
    padding: 1.1rem var(--gutter) max(1rem, env(safe-area-inset-bottom));
    background: var(--surface); color: var(--ink); border-radius: 18px 18px 0 0;
  }
  .tp-panel section { display: none; gap: 0.85rem; }
  .preview[data-paso='foto'] [data-tp-seccion='foto'],
  .preview[data-paso='medir'] [data-tp-seccion='medir'],
  .preview[data-paso='colocar'] [data-tp-seccion='colocar'] { display: grid; }
  .tp-panel h3 { margin: 0; font-size: var(--step-2); }
  .tp-panel p { margin: 0; }
  .tp-botones { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tp-botones > * { flex: 1 1 10rem; justify-content: center; }
  .tp-botones label { position: relative; cursor: pointer; }
  .tp-botones label input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tp-botones label:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .tp-consejos summary { cursor: pointer; font-weight: 500; }
  .tp-consejos ul { margin: 0.6rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; color: var(--ink-2); font-size: var(--step--1); }
  .tp-refs, .tp-chips, .tp-tira { display: flex; gap: 0.5rem; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
  .tp-refs::-webkit-scrollbar, .tp-chips::-webkit-scrollbar, .tp-tira::-webkit-scrollbar { display: none; }
  .tp-refs .chip, .tp-chips .chip { flex: none; white-space: nowrap; }
  .tp-cm { display: flex; align-items: center; gap: 0.6rem; font-weight: 500; }
  .tp-cm input {
    width: 7rem; min-height: 48px; padding: 0 0.8rem; border: 1px solid var(--rule); border-radius: 12px;
    background: var(--raised); color: var(--ink); font: 500 1.125rem var(--font-body);
  }
  .tp-cm input:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
  .tp-abarca { min-height: 1.4em; color: var(--ink-2); font-size: var(--step--1); }
  .tp-abarca[data-raro] { color: #9b2c1f; font-weight: 500; }
  .tp-tela { flex: none; width: 3.6rem; height: 3.6rem; padding: 0; border: 0; border-radius: 10px; overflow: hidden; cursor: pointer; background: none; }
  .tp-tela img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tp-tela[aria-pressed='true'] { outline: 2.5px solid var(--ink); outline-offset: 2px; }
  .tp-tira { padding-block: 4px; }
  .tp-acciones .btn { flex: 1 1 8rem; }
  .tp-enlaces { display: flex; justify-content: center; gap: 1.25rem; }
  .tp-enlaces button { border: 0; background: none; padding: 0.4rem 0; color: var(--ink-2); font: 400 var(--step--1) var(--font-body); text-decoration: underline; cursor: pointer; }

  @media (min-width: 960px) {
    .preview[data-inmersivo] { grid-template: 'cab cab' auto 'pared panel' minmax(0, 1fr) / minmax(0, 1fr) 25rem; }
    .preview[data-inmersivo] .tp-panel { max-height: none; border-radius: 0; padding: 1.75rem; }
    .tp-refs, .tp-chips, .tp-tira { flex-wrap: wrap; margin-inline: 0; padding-inline: 0; }
  }
  @media (max-width: 600px) {
    .tp-titulo { display: none; }
    .tp-pasos { margin-left: 0; }
    .tp-pasos li { padding-right: 0.45rem; }
    .tp-pasos li:not([aria-current]) { font-size: 0; gap: 0; padding: 0.3rem; }
    .tp-pasos li:not([aria-current]) span { font-size: 0.75rem; }
    .tp-cta small { display: none; }
  }

  .rooms[hidden] { display: none; }
  .rooms { border: 0; margin: 0; padding: 0; min-width: 0; display: grid; gap: 0.6rem; }
  .rooms legend { display: block; padding: 0; margin-bottom: 0.6rem; font: 500 var(--step--1) / 1.4 var(--font-body); }
  .rooms-note { color: var(--ink-2); font-weight: 400; }
  .preview:has(input[value='cerca']:checked) .rooms-note { visibility: hidden; }
  .room-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .room-chip { position: relative; cursor: pointer; }
  .room-chip input { position: absolute; opacity: 0; pointer-events: none; }
  .room-chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 1rem; border-radius: 999px;
    border: 1px solid var(--rule); font-size: var(--step--1); background: var(--raised);
  }
  .room-chip:hover span { border-color: var(--ink-2); }
  .room-chip input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--surface); }
  .room-chip input:focus-visible + span { outline: 3px solid var(--accent); outline-offset: 2px; }

  .preview-caption { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; text-align: center; color: var(--ink-2); }
  .preview-name { font: 500 var(--step-2) / 1 var(--font-display); color: var(--ink); }

  /* —— Controles —— */
  .controls { display: grid; gap: 2.25rem; }
  .step { border: 0; padding: 0; margin: 0; min-width: 0; display: grid; gap: 1rem; }
  legend { display: flex; align-items: center; gap: 0.75rem; padding: 0; margin-bottom: 1rem; font: 500 var(--step-2) / 1.1 var(--font-display); }
  .step-n {
    display: inline-grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%;
    border: 1px solid var(--rule); font: 500 var(--step--1) / 1 var(--font-body);
  }
  .legend-note { font: 400 var(--step--1) / 1 var(--font-body); color: var(--ink-2); }
  .hint { font-size: var(--step--1); color: var(--ink-2); }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 44px; padding: 0.5rem 1rem; border-radius: 999px; border: 1px solid var(--rule);
    background: transparent; color: var(--ink); font: 400 var(--step--1) / 1 var(--font-body); cursor: pointer;
  }
  .chip:hover { border-color: var(--ink-2); }
  .chip[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--surface); }

  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr)); gap: 1rem 0.75rem; }
  .swatch { display: grid; gap: 0.4rem; cursor: pointer; }
  .swatch[hidden] { display: none; }
  .swatch img { aspect-ratio: 1; width: 100%; object-fit: cover; border-radius: 10px; transition: transform 0.2s var(--ease); }
  .swatch:hover img { transform: scale(1.03); }
  .swatch input, .option input, .toggle input { position: absolute; opacity: 0; pointer-events: none; }
  .swatch:has(input:checked) img { outline: 2.5px solid var(--ink); outline-offset: 3px; }
  .swatch:has(input:focus-visible) img { outline: 3px solid var(--accent); outline-offset: 3px; }
  .swatch-img { position: relative; display: block; }
  .disenos .swatch img { aspect-ratio: 3 / 4; object-fit: contain; background: #faf8f3; }
  .swatch-name { font-size: var(--step--1); line-height: 1.25; text-align: center; }
  .badge {
    position: absolute; left: 6px; top: 6px; padding: 3px 7px; border-radius: 999px;
    background: var(--accent); color: var(--accent-ink);
    font-size: 0.6875rem; line-height: 1.2; letter-spacing: 0.04em; font-weight: 500;
  }

  .options { display: grid; gap: 0.5rem; }
  .sizes { grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); }
  .sizes .option-body > span:first-child { white-space: nowrap; }
  .frames-opts, .impresiones { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .option { position: relative; cursor: pointer; }
  .option-body {
    display: flex; align-items: center; gap: 0.75rem; min-height: 52px; padding: 0.6rem 1rem;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--surface);
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .option:hover .option-body { border-color: var(--ink-2); }
  .option input:checked + .option-body { border-color: var(--ink); box-shadow: 0 0 0 1px var(--ink) inset; }
  .option input:focus-visible + .option-body { outline: 3px solid var(--accent); outline-offset: 2px; }
  .option-price { margin-left: auto; color: var(--ink-2); font-size: var(--step--1); white-space: nowrap; }
  .wood { width: 1.4rem; height: 1.4rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15) inset; flex: none; }
  .wood[data-none='true'] { background: repeating-linear-gradient(135deg, transparent 0 4px, var(--rule) 4px 5px); }

  .toggle { display: flex; align-items: center; gap: 1rem; cursor: pointer; min-height: 52px; margin-top: 0.5rem; }
  .toggle > span:last-child { display: grid; }
  .toggle-note { color: var(--ink-2); font-size: var(--step--1); }
  .toggle-track { width: 51px; height: 31px; border-radius: 999px; background: color-mix(in oklab, var(--ink-2) 50%, var(--surface)); position: relative; flex: none; transition: background-color 0.2s var(--ease); }
  .toggle-track::after {
